---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);

// One section per `group` in the projects schema, in this order.
const sections = [
  {
    group: 'zeroalloc',
    title: 'ZeroAlloc.NET',
    intro: 'Compile-time .NET: dispatch, DI, mapping and validation generated by Roslyn, with no reflection and Native AOT safe throughout.',
  },
  {
    group: 'ai',
    title: 'AI for .NET',
    intro: 'Libraries for building, securing and grounding AI agents in .NET, and the MCP servers that give coding agents real tools.',
  },
  {
    group: 'other',
    title: 'Other libraries & tools',
    intro: 'Smaller libraries, analyzers and developer tools.',
  },
].map(section => ({ ...section, projects: projects.filter(p => p.data.group === section.group) }))
  .filter(section => section.projects.length > 0);
---

<BaseLayout title="Projects" description="Open source projects by Marcel Roozekrans: the ZeroAlloc.NET suite and AI libraries for .NET.">
  <div class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="text-4xl font-bold text-foreground mb-4">Projects</h1>
    <p class="text-muted mb-12">Open source libraries and tools I've built for the .NET ecosystem and beyond.</p>

    {sections.length === 0 ? (
      <div class="rounded-xl border border-border bg-surface p-8 text-center">
        <p class="text-muted">No projects listed yet — check back soon.</p>
      </div>
    ) : sections.map(section => (
      <section class="mb-14 last:mb-0" aria-labelledby={`group-${section.group}`}>
        <h2 id={`group-${section.group}`} class="text-2xl font-bold text-foreground mb-2">{section.title}</h2>
        <p class="text-muted mb-6">{section.intro}</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {section.projects.map(project => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              github={project.data.github}
              nuget={project.data.nuget}
              marketplace={project.data.marketplace}
              docs={project.data.docs}
            />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

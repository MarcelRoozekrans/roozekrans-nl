---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/cv', label: 'CV' },
  { href: '/blog', label: 'Blog' },
];

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur shadow-[var(--shadow-sticky)]">
  <nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 sm:px-6 py-3">
    <a href="/" class="font-mono text-base sm:text-lg font-semibold text-accent hover:text-accent-hover transition-colors">
      roozekrans.nl
    </a>
    <ul class="flex flex-wrap items-center gap-x-4 gap-y-1 sm:gap-6">
      {navLinks.map(({ href, label }) => {
        const isCurrent = pathname === href || (href !== '/' && pathname.startsWith(href));
        return (
          <li>
            <a
              href={href}
              aria-current={isCurrent ? 'page' : undefined}
              class={`inline-flex min-h-11 items-center text-sm transition-colors ${
                isCurrent ? 'font-semibold text-accent' : 'font-medium text-muted hover:text-foreground'
              }`}
            >
              <span class={isCurrent ? 'border-b border-accent pb-0.5' : ''}>{label}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
